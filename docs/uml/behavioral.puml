@startuml
!pragma layout smetana
skinparam backgroundColor #FFFEF9
skinparam classBackgroundColor #E7EEE5
skinparam classBorderColor #456B65
skinparam ArrowColor #456B65
skinparam defaultFontName Arial
hide empty members
title Strategy and Observer
class GameFacade
class AttemptService
interface AnswerCheckingStrategy <<Strategy>> {
 check(task, optionId, previous)
 canAdvance(answer)
 feedback(task, answer)
}
class LearningStrategy
class AssessmentStrategy
class AnswerEvaluator
class ChapterCompletedPublisher <<Publisher>> {
 subscribe(observer)
 publish(event, candidate)
}
class ChapterCompleted <<Event>>
interface ChapterCompletedObserver <<Observer>>
class ProgressObserver
class CompletionStatisticsObserver
class GameState
GameFacade --> AttemptService
AttemptService --> AnswerCheckingStrategy
AnswerCheckingStrategy <|.. LearningStrategy
AnswerCheckingStrategy <|.. AssessmentStrategy
LearningStrategy --> AnswerEvaluator
AssessmentStrategy --> AnswerEvaluator
GameFacade --> ChapterCompletedPublisher
ChapterCompletedPublisher --> ChapterCompletedObserver : notifies
ChapterCompletedPublisher ..> ChapterCompleted
ChapterCompletedObserver <|.. ProgressObserver
ChapterCompletedObserver <|.. CompletionStatisticsObserver
ProgressObserver --> GameState : mastered chapters
CompletionStatisticsObserver --> GameState : passed and failed
@enduml
